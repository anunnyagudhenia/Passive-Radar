- name: blocks_throttle2_0
  id: blocks_throttle2
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    ignoretag: 'True'
    limit: auto
    maximum: '0.1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_second: samp_rate
    type: float
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [408, 304.0]
    rotation: 0
    state: enabled
- name: epy_block_1
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nfrom scipy.signal\
      \ import correlate\n\n\nclass blk(gr.sync_block):\n\n    def __init__(self,\
      \ fs=1e6, capture_len=50000):\n        gr.sync_block.__init__(\n           \
      \ self,\n            name='live_corr_only',\n            in_sig=[np.float32,\
      \ np.float32],\n            out_sig=[np.float32]\n        )\n\n        self.fs\
      \ = fs\n        self.capture_len = capture_len\n\n        self.b1 = []\n   \
      \     self.b2 = []\n\n\n    def work(self, input_items, output_items):\n\n \
      \       ch1 = input_items[0]\n        ch2 = input_items[1]\n\n        # ----\
      \ collect samples ----\n        self.b1.extend(ch1.tolist())\n        self.b2.extend(ch2.tolist())\n\
      \n        if len(self.b1) >= self.capture_len:\n\n            x = np.array(self.b1)\n\
      \            y = np.array(self.b2)\n\n            n = len(x)\n\n           \
      \ # ===== SAME CORE LOGIC AS YOUR SCRIPT =====\n            cross_corr = correlate(\n\
      \                x - np.mean(x),\n                y - np.mean(y),\n        \
      \        mode='full'\n            ) / n\n            # ==========================================\n\
      \n            # stream out part of result\n            L = len(output_items[0])\n\
      \            output_items[0][:] = cross_corr[:L]\n\n            self.b1 = []\n\
      \            self.b2 = []\n\n        return len(output_items[0])\n"
    affinity: ''
    alias: ''
    capture_len: '500'
    comment: ''
    fs: 1e6
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('live_corr_only', 'blk', [('fs', '1000000.0'), ('capture_len', '50000')],
      [('0', 'float', 1), ('1', 'float', 1)], [('0', 'float', 1)], '', ['capture_len',
      'fs'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1000, 340.0]
    rotation: 0
    state: enabled
- name: qtgui_time_sink_x_0
